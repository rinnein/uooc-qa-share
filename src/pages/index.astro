---
import Layout from "@/layouts/Layout.astro";
import SearchBar from "@/components/SearchBar";
---

<Layout title="UOOC QA Share - 题库共享平台">
  <div class="flex flex-col items-center gap-8 py-12">
    <div class="text-center space-y-3">
      <h1 class="text-4xl font-bold tracking-tight">UOOC 题库共享</h1>
      <p class="text-muted-foreground text-lg max-w-lg">
        搜索、分享 UOOC 优课联盟的测验题目与答案，提高答题效率
      </p>
    </div>

    <div class="w-full max-w-xl">
      <SearchBar client:load />
    </div>

    <div class="grid gap-4 sm:grid-cols-4 w-full max-w-3xl text-center">
      <div class="rounded-lg border p-4 space-y-1">
        <div class="text-2xl">🔍</div>
        <h3 class="font-semibold">搜索题目</h3>
        <p class="text-sm text-muted-foreground">
          通过课程号、题组号或题干关键词搜索
        </p>
      </div>
      <div class="rounded-lg border p-4 space-y-1">
        <div class="text-2xl">📤</div>
        <h3 class="font-semibold">批量上传</h3>
        <p class="text-sm text-muted-foreground">
          支持 API、MCP 和前端上传多种方式
        </p>
      </div>
      <div class="rounded-lg border p-4 space-y-1">
        <div class="text-2xl">🔌</div>
        <h3 class="font-semibold">插件集成</h3>
        <p class="text-sm text-muted-foreground">
          为 fuckuooc、your-szu-life 等插件提供 API
        </p>
      </div>
      <a href="/mcp-guide" class="rounded-lg border border-primary/30 bg-primary/5 p-4 space-y-1 hover:bg-primary/10 transition-colors block">
        <div class="text-2xl">🤖</div>
        <h3 class="font-semibold text-primary">MCP + Agent</h3>
        <p class="text-sm text-muted-foreground">
          支持 Claude、Cursor 等本地 Agent 自动清洗入库
        </p>
      </a>
    </div>
  </div>
</Layout>
