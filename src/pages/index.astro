---
import Layout from "@/layouts/Layout.astro";
import SearchBar from "@/components/SearchBar";
import { db } from "@/db";
import { questions, courses, taskGroups, answers } from "@/db/schema";
import { sql, eq } from "drizzle-orm";

let stats = {
  questions: 0,
  courses: 0,
  taskGroups: 0,
  correctAnswers: 0,
  excludedAnswers: 0,
};

try {
  const [qCount] = await db.select({ count: sql<number>`count(*)` }).from(questions);
  const [cCount] = await db.select({ count: sql<number>`count(*)` }).from(courses);
  const [tCount] = await db.select({ count: sql<number>`count(*)` }).from(taskGroups);
  const [aCount] = await db
    .select({ count: sql<number>`count(*)` })
    .from(answers)
    .where(eq(answers.isCorrect, true));
  const [wCount] = await db
    .select({ count: sql<number>`count(*)` })
    .from(answers)
    .where(eq(answers.isCorrect, false));

  stats = {
    questions: Number(qCount?.count ?? 0),
    courses: Number(cCount?.count ?? 0),
    taskGroups: Number(tCount?.count ?? 0),
    correctAnswers: Number(aCount?.count ?? 0),
    excludedAnswers: Number(wCount?.count ?? 0),
  };
} catch (e) {
  console.error("Failed to load statistics on index:", e);
}
---

<Layout title="UOOC QA Share - 题库共享平台">
  <div class="flex flex-col items-center gap-8 py-10">
    <div class="text-center space-y-3">
      <h1 class="text-4xl font-bold tracking-tight">UOOC 题库共享</h1>
      <p class="text-muted-foreground text-lg max-w-lg">
        搜索、分享 UOOC 优课联盟的测验题目与答案，提高答题效率
      </p>
    </div>

    <div class="w-full max-w-xl">
      <SearchBar client:load />
    </div>

    <!-- 题库统计数据概览 -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 w-full max-w-4xl">
      <div class="rounded-xl border bg-card/60 p-4 text-center space-y-1 shadow-sm">
        <div class="text-xs font-medium text-muted-foreground uppercase tracking-wider">题目总数</div>
        <div class="text-3xl font-bold tracking-tight text-foreground">{stats.questions.toLocaleString()}</div>
        <div class="text-[11px] text-muted-foreground">已收录试题</div>
      </div>
      <div class="rounded-xl border bg-card/60 p-4 text-center space-y-1 shadow-sm">
        <div class="text-xs font-medium text-muted-foreground uppercase tracking-wider">正确答案</div>
        <div class="text-3xl font-bold tracking-tight text-foreground">{stats.correctAnswers.toLocaleString()}</div>
        <div class="text-[11px] text-muted-foreground">已确认标准答案</div>
      </div>
      <div class="rounded-xl border bg-card/60 p-4 text-center space-y-1 shadow-sm">
        <div class="text-xs font-medium text-muted-foreground uppercase tracking-wider">已排除答案</div>
        <div class="text-3xl font-bold tracking-tight text-foreground">{stats.excludedAnswers.toLocaleString()}</div>
        <div class="text-[11px] text-muted-foreground">用户提交确认错误</div>
      </div>
      <div class="rounded-xl border bg-card/60 p-4 text-center space-y-1 shadow-sm">
        <div class="text-xs font-medium text-muted-foreground uppercase tracking-wider">测验题单</div>
        <div class="text-3xl font-bold tracking-tight text-foreground">{stats.taskGroups.toLocaleString()}</div>
        <div class="text-[11px] text-muted-foreground">单元测验 / 作业</div>
      </div>
      <div class="rounded-xl border bg-card/60 p-4 text-center space-y-1 shadow-sm col-span-2 sm:col-span-1">
        <div class="text-xs font-medium text-muted-foreground uppercase tracking-wider">覆盖课程</div>
        <div class="text-3xl font-bold tracking-tight text-foreground">{stats.courses.toLocaleString()}</div>
        <div class="text-[11px] text-muted-foreground">联盟收录课程</div>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-4 w-full max-w-3xl text-center">
      <a href="/courses" class="rounded-lg border p-4 space-y-1 hover:bg-accent/50 hover:border-primary/40 transition-colors block">
        <div class="text-2xl">📚</div>
        <h3 class="font-semibold">课程题单</h3>
        <p class="text-sm text-muted-foreground">
          按课程目录浏览测验试卷与题目
        </p>
      </a>
      <a href="/search" class="rounded-lg border p-4 space-y-1 hover:bg-accent/50 hover:border-primary/40 transition-colors block">
        <div class="text-2xl">🔍</div>
        <h3 class="font-semibold">搜索题目</h3>
        <p class="text-sm text-muted-foreground">
          通过关键词或向量语义检索题库
        </p>
      </a>
      <a href="/upload" class="rounded-lg border p-4 space-y-1 hover:bg-accent/50 hover:border-primary/40 transition-colors block">
        <div class="text-2xl">📤</div>
        <h3 class="font-semibold">批量上传</h3>
        <p class="text-sm text-muted-foreground">
          AI 智能清洗与 JSON 数据入库
        </p>
      </a>
      <a href="/mcp-guide" class="rounded-lg border p-4 space-y-1 hover:bg-accent/50 hover:border-primary/40 transition-colors block">
        <div class="text-2xl">🤖</div>
        <h3 class="font-semibold">MCP + Agent</h3>
        <p class="text-sm text-muted-foreground">
          一键指导 AI 自动接入本地清洗
        </p>
      </a>
    </div>
  </div>
</Layout>
