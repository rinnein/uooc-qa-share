---
import Layout from "@/layouts/Layout.astro";
import SearchResults from "@/components/SearchResults";

const query = Astro.url.searchParams.get("q") ?? "";
---

<Layout title={query ? `搜索: ${query}` : "搜索题目"}>
  <div class="space-y-6">
    <h1 class="text-2xl font-bold">搜索题目</h1>
    <SearchResults initialQuery={query} client:load />
  </div>
</Layout>
