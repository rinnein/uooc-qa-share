---
import "@/styles/globals.css";
import NavbarAuth from "@/components/NavbarAuth";

interface Props {
  title?: string;
}

const { title = "UOOC QA Share" } = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  {
    href: "/",
    label: "首页",
    isActive: pathname === "/",
  },
  {
    href: "/courses",
    label: "课程题单",
    isActive:
      pathname === "/courses" ||
      pathname.startsWith("/courses/") ||
      pathname.startsWith("/tasks/"),
  },
  {
    href: "/search",
    label: "搜索",
    isActive: pathname === "/search" || pathname.startsWith("/questions/"),
  },
  {
    href: "/upload",
    label: "上传",
    isActive: pathname === "/upload" || pathname.startsWith("/upload/"),
  },
  {
    href: "/mcp-guide",
    label: "MCP / Agent",
    isActive: pathname === "/mcp-guide" || pathname.startsWith("/mcp-guide/"),
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Webview / URL API Key auto-injection and persistence
      (function () {
        try {
          var url = new URL(window.location.href);
          var apiKey = url.searchParams.get("apiKey") || url.searchParams.get("api_key");

          if (!apiKey && window.__UOOC_API_KEY__) {
            apiKey = window.__UOOC_API_KEY__;
          }

          if (apiKey) {
            localStorage.setItem("uooc_api_key", apiKey);
            document.cookie =
              "apiKey=" +
              encodeURIComponent(apiKey) +
              "; path=/; max-age=2678400; SameSite=Lax";

            // Clean up the parameter from URL query string without reloading
            if (url.searchParams.has("apiKey") || url.searchParams.has("api_key")) {
              url.searchParams.delete("apiKey");
              url.searchParams.delete("api_key");
              window.history.replaceState(null, "", url.toString());
            }
          }
        } catch (e) {
          console.error("Failed to initialize injected API key", e);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-5xl items-center gap-4 px-4">
        <a href="/" class="text-lg font-bold tracking-tight shrink-0">UOOC QA</a>
        <nav class="flex items-center gap-1 sm:gap-2 text-sm overflow-x-auto">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "px-2.5 py-1 rounded-md text-sm transition-colors whitespace-nowrap",
                  item.isActive
                    ? "bg-accent text-accent-foreground font-medium"
                    : "text-muted-foreground hover:text-foreground hover:bg-accent/50",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto shrink-0">
          <NavbarAuth client:load />
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-6">
      <slot />
    </main>
  </body>
</html>
